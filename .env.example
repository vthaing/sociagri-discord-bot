# ============================================================
#  SociAgri Discord Bot — copy file nay thanh `.env` roi dien
#  cp .env.example .env
# ============================================================

# --- 1. Discord (BAT BUOC) ---------------------------------
# Lay o https://discord.com/developers/applications
#   → App cua ban → Bot → Reset Token → Copy
DISCORD_TOKEN=

# Discord user ID duoc phep hoi bot (cach nhau bang dau phay).
# Bat buoc — de trong thi bot KHONG tra loi ai (fail-closed).
# Lay ID: Discord → Settings → Advanced → bat Developer Mode
#         → click phai vao ten nguoi → Copy User ID
ALLOWED_USER_IDS=

# (Tuy chon) Chi hoat dong trong nhung channel / server nay.
# De trong = moi channel bot thay (van phai qua whitelist user o tren).
ALLOWED_CHANNEL_IDS=
ALLOWED_GUILD_IDS=

# Cho phep tra loi tin nhan rieng (DM)? true/false
ALLOW_DM=false


# --- 2. Claude (KHONG can Anthropic API key) ---------------
# Token subscription lay bang: claude setup-token
# (day KHONG phai API key tra phi — no dung goi Claude Pro/Max cua ban)
# Neu de trong, bot dua vao dang nhap Keychain cua may — hoat dong khi
# chay tay trong Terminal, nhung co the that bai khi chay nen qua launchd.
CLAUDE_CODE_OAUTH_TOKEN=

# Duong dan TUYET DOI tới claude CLI (launchd khong co PATH cua nvm)
CLAUDE_BIN=/Users/vthaing/.nvm/versions/node/v22.20.0/bin/claude

# Repo de bot doc code + tai lieu khi tra loi
REPO_DIR=/Users/vthaing/WORKING_AREA/PROJECTS/sociagri

# sonnet = nhanh & du dung | opus = thong minh hon, cham hon
CLAUDE_MODEL=sonnet

# Thoi gian toi da cho 1 cau tra loi (ms)
CLAUDE_TIMEOUT_MS=180000


# --- 3. Gioi han (chong ngop may + chong spam) -------------
# Nho ngu canh hoi thoai trong 1 channel bao lau (ms) — 2 gio
SESSION_TTL_MS=7200000
# So cau hoi cho toi da trong hang doi
MAX_QUEUED=5
# Moi user phai cho bao lau giua 2 cau hoi (ms)
USER_COOLDOWN_MS=10000
# Toi da so cau hoi / user / gio
USER_HOURLY_LIMIT=30


# --- 4. Khac ----------------------------------------------
SYSTEM_PROMPT_FILE=system-prompt.md
LOG_FILE=logs/bot.log
PRESENCE_TEXT=tra loi ho Vince ve SociAgri
