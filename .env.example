# ============================================================
#  SociAgri Discord Bot — copy file nay thanh `.env` roi dien
#  cp .env.example .env
# ============================================================

# --- 1. Discord (BAT BUOC) ---------------------------------
# Lay o https://discord.com/developers/applications
#   → App cua ban → Bot → Reset Token → Copy
DISCORD_TOKEN=

# Discord user ID duoc phep hoi bot (cach nhau bang dau phay).
# Bat buoc — de trong thi bot KHONG tra loi ai (fail-closed).
# Lay ID: Discord → Settings → Advanced → bat Developer Mode
#         → click phai vao ten nguoi → Copy User ID
ALLOWED_USER_IDS=

# (Tuy chon) Chi hoat dong trong nhung channel / server nay.
# De trong = moi channel bot thay (van phai qua whitelist user o tren).
ALLOWED_CHANNEL_IDS=
ALLOWED_GUILD_IDS=

# Cho phep tra loi tin nhan rieng (DM)? true/false
# (Owner o duoi LUON DM duoc, du bien nay = false)
ALLOW_DM=false

# --- Owner: chu du an -------------------------------------
# Discord user ID cua chu du an. Owner duoc hoi thong tin NOI BO ma nguoi khac
# bi tu choi: tien do that, viec con no, deadline uoc luong, so lieu, chi phi,
# thong tin kinh doanh, danh gia rui ro ky thuat.
# LUU Y: KHONG bao gom secret — gia tri .env / API key / token KHONG duoc gui qua
# Discord cho bat ky ai, ke ca owner (Discord luu tin nhan mai, khong ma hoa
# dau-cuoi; chu du an ngoi ngay tren may nen doc truc tiep an toan hon).
# Owner PHAI co trong ALLOWED_USER_IDS o tren.
OWNER_USER_IDS=

# Owner hoi trong channel server co duoc tra loi thong tin noi bo khong?
# false = chi tra loi noi bo trong DM rieng (nhung nguoi khac trong channel
# khong doc duoc thong tin noi bo).
OWNER_INTERNAL_IN_CHANNELS=true


# --- 2. Claude (KHONG can Anthropic API key) ---------------
# Token subscription lay bang: claude setup-token
# (day KHONG phai API key tra phi — no dung goi Claude Pro/Max cua ban)
# Neu de trong, bot dua vao dang nhap Keychain cua may — hoat dong khi
# chay tay trong Terminal, nhung co the that bai khi chay nen qua launchd.
CLAUDE_CODE_OAUTH_TOKEN=

# Duong dan TUYET DOI tới claude CLI (launchd khong co PATH cua nvm)
CLAUDE_BIN=/Users/vthaing/.nvm/versions/node/v22.20.0/bin/claude

# Repo de bot doc code + tai lieu khi tra loi
REPO_DIR=/Users/vthaing/WORKING_AREA/PROJECTS/sociagri

# sonnet = nhanh & du dung | opus = thong minh hon, cham hon
CLAUDE_MODEL=sonnet

# Thoi gian toi da cho 1 cau tra loi (ms)
CLAUDE_TIMEOUT_MS=180000


# --- 3. Gioi han (chong ngop may + chong spam) -------------
# Nho ngu canh hoi thoai trong 1 channel bao lau (ms) — 2 gio
SESSION_TTL_MS=7200000
# So cau hoi cho toi da trong hang doi
MAX_QUEUED=5
# Moi user phai cho bao lau giua 2 cau hoi (ms)
USER_COOLDOWN_MS=10000
# Toi da so cau hoi / user / gio
USER_HOURLY_LIMIT=30


# --- 4. Khac ----------------------------------------------
# --- Bot GUI file len Discord -----------------------------
# Cau tra loi dai hon OUTBOUND_MAX_INLINE_CHARS -> gui thanh file .md dinh kem
# (thay vi cat vun thanh nhieu tin nhan). Bot cung dinh kem duoc file trong repo
# khi cau tra loi dung cu phap [[attach: duong/dan]].
# File secret (.env*, *.key, *.p8, keystore, credentials*) va file ngoai repo
# LUON bi tu choi, khong the ghi de bang env.
OUTBOUND_FILES_ENABLED=true
# Cau tra loi dai duoc chia thanh NHIEU TIN NHAN co danh so (1/4). Chi khi vuot
# so tin nay moi dong goi thanh file .md (moi tin ~1900 ky tu => 6 tin ~ 11k ky tu).
OUTBOUND_MAX_MESSAGES=6
OUTBOUND_MAX_FILE_BYTES=8388608
OUTBOUND_MAX_FILES=3

# --- Anh / screenshot dinh kem ----------------------------
# Bot tai anh trong tin nhan ve thu muc tam de doc, roi XOA ngay sau khi tra loi.
# Chi nhan anh (png/jpg/gif/webp) tu CDN Discord; file khac bi bo qua.
ATTACHMENTS_ENABLED=true
ATTACHMENT_MAX_COUNT=4
ATTACHMENT_MAX_BYTES=10485760
# true = cau hoi CO ANH khong luu transcript. Ly do: claude luu anh dang base64 vao
# ~/.claude/projects/**.jsonl va nam do vinh vien, du bot da xoa file tam.
# Screenshot QC co the chua du lieu nguoi dung that => mac dinh true.
# Danh doi: rieng cau hoi co anh se khong giu ngu canh hoi thoai.
ATTACHMENT_NO_PERSIST=true

SYSTEM_PROMPT_FILE=system-prompt.md
LOG_FILE=logs/bot.log
PRESENCE_TEXT=tra loi ho Vince ve SociAgri
